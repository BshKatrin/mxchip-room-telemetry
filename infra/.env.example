BACKEND_IMAGE=mxchip-room-telemetry-api:latest
# Public IPv4 address for the Let's Encrypt IP certificate.
PUBLIC_HOST=your-ec2-public-ip
HTTP_PORT=80
# Bootstrap only; HTTPS mode replaces this loopback binding with port 443.
GRAFANA_LOCAL_PORT=8080

INFLUX_USERNAME=admin
INFLUX_LOCAL_PORT=8086
INFLUX_PASSWORD=change-me-influx-password
INFLUX_TOKEN=change-me-influx-token
INFLUX_ORG=mxchip
INFLUX_BUCKET=room_telemetry
INFLUX_ENABLED=true

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
